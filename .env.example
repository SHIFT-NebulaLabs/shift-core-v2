# ─── DEPLOYER ─────────────────────────────────────────────────────────────────
# Public address only — private key is NEVER stored here.
# Pass the key at runtime: forge script ... --interactive (Foundry prompts securely).
DEPLOYER_ADDRESS=0x...     # EOA that signs the deploy transactions

# ─── RPC  (passed via --rpc-url flag, e.g. forge script ... --rpc-url $RPC_URL) ──
RPC_URL=https://...
HOME_RPC=https://...
REMOTE_RPC=https://...

# ─── SINGLETONS  (DeploySingletons.s.sol) ────────────────────────────────────
MULTISIG=0x...             # Gnosis Safe — receives ADMIN_ROLE + DEFAULT_ADMIN_ROLE
GUARDIAN=0x...             # receives GUARDIAN_ROLE (can equal MULTISIG)
TIMELOCK_DELAY=172800      # seconds (172800 = 2 days)

# ─── VAULT  (DeployVault.s.sol) ───────────────────────────────────────────────
VAULT_ASSET=0x...
VAULT_SHARE_NAME=Shift Yield Share USDC
VAULT_SHARE_SYMBOL=syUSDC
VAULT_KEEPER=0x...
VAULT_ALLOCATOR=0x...
VAULT_FEE_RECIPIENT=0x...
VAULT_INITIAL_PRICE=1000000  # raw asset units: 1000000 = 1.0 USDC (6 dec), 1000000000000000000 = 1.0 WETH (18 dec)

# ─── OFT  (DeployOFTAdapter.s.sol + DeployOFTPeer.s.sol) ─────────────────────
LZ_ENDPOINT=0x...          # LayerZero EndpointV2 on the target chain
OFT_OWNER=0x...            # controls peer config and rate limits

# ─── OFT WIRING  (WireOFT.s.sol) ─────────────────────────────────────────────
ADAPTER_EID=30184          # LZ endpoint ID of home chain
PEER_EID=30110             # LZ endpoint ID of remote chain
ENFORCED_GAS=80000         # gas for lzReceive on destination (profile before setting)
RATE_LIMIT_AMOUNT=1000000000000000000000000  # max outbound per window (raw units)
RATE_LIMIT_WINDOW=3600     # window in seconds
# PEER_BYTES32=0x...       # non-EVM only (Cairo/Starknet): raw bytes32 peer address

# ─── TESTNET BRIDGE TEST  (TestBridge.s.sol) ─────────────────────────────────
BRIDGE_AMOUNT=1000000             # raw token units to bridge (e.g. 1 USDC = 1000000)
# BRIDGE_RECIPIENT=0x...          # optional: defaults to sender address
# BRIDGE_RECIPIENT_BYTES32=0x...  # optional: Cairo/non-EVM recipient as raw bytes32

# ─── DEPLOYED ADDRESSES  (fill after each deploy step) ───────────────────────
# Singletons:
REGISTRY=0x...
ADMIN_GATEWAY=0x...
HUB=0x...
# Vault:
SYSHARE=0x...
VAULT_ID=1                 # emitted in VaultRegistered event
# VAULT_OFT=0x...          # set after OFT adapter is deployed
# OFT:
ADAPTER=0x...
PEER=0x...
