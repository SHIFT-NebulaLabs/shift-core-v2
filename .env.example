# ============================================================================
# EVM Deployment Configuration
# Copy to .env and fill in values: cp .env.example .env
# ⚠️  Never commit .env to git — add it to .gitignore.
# ⚠️  No inline comments on value lines — Make's -include strips nothing after #
#     and inline comments corrupt the value. Put comments above the variable.
# ============================================================================


# ============================================================================
# 1. Connection
# ============================================================================

# ── Deployer ─────────────────────────────────────────────────────────────────

# Foundry keystore account name (created via: cast wallet import <name> --interactive)
DEPLOYER_ACCOUNT=deployer
DEPLOYER_ADDRESS=0x...

# ── RPC Endpoints ────────────────────────────────────────────────────────────

RPC_URL=https://...
HOME_RPC=https://...
REMOTE_RPC=https://...

# ── Verification ─────────────────────────────────────────────────────────────

# Arbiscan / Basescan / Etherscan all use the same key format.
# Get your key at: https://arbiscan.io/myapikey
ETHERSCAN_API_KEY=

# Optional Blockscout verification for protocol deployments.
# Get a PRO key from https://dev.blockscout.com (not an explorer MyAccount key).
# Set the chain_id in VERIFIER_URL to the deployment chain.
# VERIFIER=blockscout
# VERIFIER_URL=https://api.blockscout.com/4663/api
# BLOCKSCOUT_API_KEY=
# Foundry 1.5.1 workaround for Robinhood explorer trace identification.
# Requires the configured solc compiler to be installed already.
# PROTOCOL_SCRIPT_ARGS=--offline


# ============================================================================
# 2. Protocol Roles
# ============================================================================

# Safe multisig — receives ADMIN_ROLE + DEFAULT_ADMIN_ROLE on AdminGateway
MULTISIG=0x...

# Guardian — receives GUARDIAN_ROLE (can equal MULTISIG)
GUARDIAN=0x...

# Timelock delay in seconds — 1 for testnet, 172800 (2 days) for mainnet
TIMELOCK_DELAY=172800


# ============================================================================
# 3. Vault
# ============================================================================

# ── Underlying ───────────────────────────────────────────────────────────────

VAULT_ASSET=0x...
VAULT_SHARE_NAME=Shift Yield Share USDC
VAULT_SHARE_SYMBOL=syUSDC

# ── Operators ────────────────────────────────────────────────────────────────

VAULT_KEEPER=0x...
VAULT_ALLOCATOR=0x...
VAULT_FEE_RECIPIENT=0x...

# ── Pricing ──────────────────────────────────────────────────────────────────

# Genesis share price in raw asset units — must equal 10 ** assetDecimals
# USDC (6 dec) → 1000000 | WETH (18 dec) → 1000000000000000000
VAULT_INITIAL_PRICE=1000000

# Accept requestFastRedeem() at launch (toggle later via AdminGateway)
VAULT_FAST_REDEEM_ENABLED=true


# ============================================================================
# 4. OFT Bridge (Optional)
# ============================================================================

# LZ infrastructure (endpoint, libs, executor, DVNs) is resolved automatically
# from lz-address-book via block.chainid on supported EVM chains.
# For unsupported chains, set the manual fallback vars below.
#
# Testnet EIDs:
#   Arbitrum Sepolia : 40231   HOME_RPC=https://sepolia-rollup.arbitrum.io/rpc
#   Base Sepolia     : 40245   REMOTE_RPC=https://sepolia.base.org

# ── Ownership ────────────────────────────────────────────────────────────────

# Controls peer config and rate limits
OFT_OWNER=0x...

# ── Cross-chain Config ───────────────────────────────────────────────────────

# Arbitrum Sepolia
ADAPTER_EID=40231
# Base Sepolia
PEER_EID=40245
# non-EVM only (Cairo/Starknet): raw bytes32 peer address
# PEER_BYTES32=0x...

# ── Gas & Rate Limits ────────────────────────────────────────────────────────

# Gas for lzReceive on destination (profile before setting)
ENFORCED_GAS=80000

# Max outbound per window (raw units)
RATE_LIMIT_AMOUNT=1000000000000000000000000
# Window in seconds
RATE_LIMIT_WINDOW=3600

# ── DVN Config ───────────────────────────────────────────────────────────────

# DVN_COUNT=1  testnet  — one required DVN
# DVN_COUNT=2  mainnet  — two required DVNs
DVN_COUNT=1
# Minimum source block confirmations before DVNs verify (1 ok for testnet)
BLOCK_CONFIRMATIONS=1

# Address book mode (default for supported EVM chains): DVN provider names,
# addresses resolved automatically per chain. Names are case-sensitive and
# must match lz-address-book canonical names.
DVN_1_NAME=LayerZero Labs
# DVN_2_NAME=Nethermind

# ── Manual Fallback ──────────────────────────────────────────────────────────

# Only needed when the address book cannot resolve (Starknet pathway, custom
# DVN not in the book). DVN addresses must be sorted ascending.
# LZ_ENDPOINT=0x...
# SEND_LIB=0x...
# RECEIVE_LIB=0x...
# EXECUTOR=0x...
# DVN_1=0x...
# DVN_2=0x...

# ── Bridge Test ──────────────────────────────────────────────────────────────

# Raw token units — 100 tokens @ 18 decimals
BRIDGE_AMOUNT=100000000000000000000
# Optional: defaults to sender address
# BRIDGE_RECIPIENT=0x...
# Optional: Cairo/non-EVM recipient as raw bytes32
# BRIDGE_RECIPIENT_BYTES32=0x...


# ============================================================================
# 5. Addons (Optional)
# ============================================================================

# ── Mock Token (testnet only) ────────────────────────────────────────────────

# Raw units minted to deployer — 1000 tokens @ 18 decimals
MINT_AMOUNT=1000000000000000000000


# ============================================================================
# 6. Deployed Addresses (fill after each deploy step)
# ============================================================================

# ── Singletons ───────────────────────────────────────────────────────────────

REGISTRY=0x...
ADMIN_GATEWAY=0x...
HUB=0x...

# ── Vault ────────────────────────────────────────────────────────────────────

SYSHARE=0x...
LIQUIDITY_POOL=0x...
SYVAULT=0x...
# Emitted in VaultRegistered event
VAULT_ID=1
# Set after OFT adapter is deployed
# VAULT_OFT=0x...

# ── OFT ──────────────────────────────────────────────────────────────────────

ADAPTER=0x...
PEER=0x...
