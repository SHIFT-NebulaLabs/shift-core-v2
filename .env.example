# ─── IMPORTANT: no inline comments on value lines ────────────────────────────
# Make's -include strips nothing after # — inline comments corrupt the value.
# Put comments on their own line above the variable, like this file does.

# ─── DEPLOYER ─────────────────────────────────────────────────────────────────
# Public address only — private key is NEVER stored here.
# Pass the key at runtime: forge script ... --interactives 1 (Foundry prompts securely).
DEPLOYER_ADDRESS=0x...

# ─── RPC ──────────────────────────────────────────────────────────────────────
RPC_URL=https://...
HOME_RPC=https://...
REMOTE_RPC=https://...

# ─── VERIFICATION ─────────────────────────────────────────────────────────────
# Arbiscan / Basescan / Etherscan all use the same key format.
# Get your key at: https://arbiscan.io/myapikey
ETHERSCAN_API_KEY=

# ─── SINGLETONS  (DeploySingletons.s.sol) ────────────────────────────────────
# MULTISIG: Gnosis Safe — receives ADMIN_ROLE + DEFAULT_ADMIN_ROLE
MULTISIG=0x...
# GUARDIAN: receives GUARDIAN_ROLE (can equal MULTISIG)
GUARDIAN=0x...
# seconds (172800 = 2 days)
TIMELOCK_DELAY=172800

# ─── VAULT  (DeployVault.s.sol) ───────────────────────────────────────────────
VAULT_ASSET=0x...
VAULT_SHARE_NAME=Shift Yield Share USDC
VAULT_SHARE_SYMBOL=syUSDC
VAULT_KEEPER=0x...
VAULT_ALLOCATOR=0x...
VAULT_FEE_RECIPIENT=0x...
# raw asset units: 1000000 = 1.0 USDC (6 dec), 1000000000000000000 = 1.0 WETH (18 dec)
VAULT_INITIAL_PRICE=1000000

# ─── MOCK TOKEN  (DeployMockToken.s.sol — testnet only) ──────────────────────
# raw units minted to deployer — 1000 tokens @ 18 decimals
MINT_AMOUNT=1000000000000000000000

# ─── OFT  (DeployOFTAdapter.s.sol + DeployOFTPeer.s.sol) ─────────────────────
# LZ V2 EndpointV2 address is the same on all EVM chains:
#   0x6EDCE65403992e310A62460808c4b910D972f10f
#
# Testnet EIDs:
#   Arbitrum Sepolia : 40231   HOME_RPC=https://sepolia-rollup.arbitrum.io/rpc
#   Base Sepolia     : 40245   REMOTE_RPC=https://sepolia.base.org
LZ_ENDPOINT=0x6EDCE65403992e310A62460808c4b910D972f10f
# controls peer config and rate limits
OFT_OWNER=0x...

# ─── OFT WIRING  (WireOFT.s.sol) ─────────────────────────────────────────────
# Arbitrum Sepolia
ADAPTER_EID=40231
# Base Sepolia
PEER_EID=40245
# gas for lzReceive on destination (profile before setting)
ENFORCED_GAS=80000
# max outbound per window (raw units)
RATE_LIMIT_AMOUNT=1000000000000000000000000
# window in seconds
RATE_LIMIT_WINDOW=3600
# non-EVM only (Cairo/Starknet): raw bytes32 peer address
# PEER_BYTES32=0x...

# ─── DVN CONFIG  (WireOFT_DVN.s.sol) ─────────────────────────────────────────
# Find all addresses at:
#   https://docs.layerzero.network/v2/deployments/chains/arbitrum-sepolia  (home)
#   https://docs.layerzero.network/v2/deployments/chains/base-sepolia      (remote)
#
# DVN_COUNT=1  testnet  — LayerZero Labs DVN only (set DVN_HOME + DVN_REMOTE, leave _2 vars blank)
# DVN_COUNT=2  mainnet  — two required DVNs (sorted ascending per chain)
DVN_COUNT=1
# A -> B send  : SendUln302 on HOME chain
SEND_LIB=0x...
# B -> A receive: ReceiveUln302 on HOME chain
HOME_RECEIVE_LIB=0x...
# A -> B receive: ReceiveUln302 on REMOTE chain
RECEIVE_LIB=0x...
# B -> A send  : SendUln302 on REMOTE chain
REMOTE_SEND_LIB=0x...
# A -> B executor: LayerZero Executor on HOME chain
EXECUTOR=0x...
# B -> A executor: LayerZero Executor on REMOTE chain
REMOTE_EXECUTOR=0x...
# LZ DVN address on the HOME chain (used for home-chain send + receive config)
DVN_HOME=0x...
# LZ DVN address on the REMOTE chain (used for remote-chain send + receive config)
DVN_REMOTE=0x...
# Mainnet only (DVN_COUNT=2): second DVN on home chain, sorted ascending after DVN_HOME
# DVN_HOME_2=0x...
# Mainnet only (DVN_COUNT=2): second DVN on remote chain, sorted ascending after DVN_REMOTE
# DVN_REMOTE_2=0x...
# Minimum source block confirmations before DVNs verify (1 is fine for testnet)
BLOCK_CONFIRMATIONS=1

# ─── TESTNET BRIDGE TEST  (TestBridge.s.sol) ─────────────────────────────────
# raw token units — 100 tokens @ 18 decimals
BRIDGE_AMOUNT=100000000000000000000
# optional: defaults to sender address
# BRIDGE_RECIPIENT=0x...
# optional: Cairo/non-EVM recipient as raw bytes32
# BRIDGE_RECIPIENT_BYTES32=0x...

# ─── DEPLOYED ADDRESSES  (fill after each deploy step) ───────────────────────
# Singletons:
REGISTRY=0x...
ADMIN_GATEWAY=0x...
HUB=0x...
# Vault:
SYSHARE=0x...
# emitted in VaultRegistered event
VAULT_ID=1
# set after OFT adapter is deployed
# VAULT_OFT=0x...
# OFT:
ADAPTER=0x...
PEER=0x...
